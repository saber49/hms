# ============================================================
# FrankenPHP edge — PRODUCTION replica of all nginx vhosts
# Replaces: sites-enabled/clood-x.com, hms, saberplan-block.conf,
#           staging.clood-x.com
# PHP served by embedded FrankenPHP PHP 8.5 (classic mode).
# ============================================================
{
	auto_https off
	frankenphp {
		php_ini memory_limit 128M
		php_ini upload_max_filesize 20M
		php_ini post_max_size 22M
		php_ini max_execution_time 60
		php_ini expose_php Off
	}
}

# ---------- alt TLDs -> clood-x.com ----------
http://clood-x.de:8088, http://clood-x.org:8088, http://clood-x.store:8088 {
	redir https://clood-x.com{uri} 301
}
clood-x.de:8443, clood-x.org:8443, clood-x.store:8443 {
	tls /etc/frankenphp/certs/clood-x.de.crt /etc/frankenphp/certs/clood-x.de.key
	redir https://clood-x.com{uri} 301
}

# ---------- saberplan: connection abort (nginx 444) ----------
http://saberplan.com:8088, http://www.saberplan.com:8088, http://*.saberplan.com:8088 {
	abort
}
saberplan.com:8443, www.saberplan.com:8443, *.saberplan.com:8443 {
	tls /etc/frankenphp/certs/saberplan.com.crt /etc/frankenphp/certs/saberplan.com.key
	abort
}

# ---------- direct IP access (nginx "hms" site) ----------
http://87.106.142.253:8088 {
	root * /var/www/hms-frontend
	request_body {
		max_size 20MB
	}
	@hmsdot path /.ht* /.env* */.ht* */.env*
	respond @hmsdot 403
	@hmsproxy path /api /api/* /sanctum /sanctum/* /share/*
	handle @hmsproxy {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
	@hmsPhp {
		path *.php
		file {path}
	}
	php @hmsPhp
	file_server {
		index index.html index.htm
	}
}

# ---------- HTTP -> HTTPS (clood hosts) ----------
http://clood-x.com:8088, http://www.clood-x.com:8088, http://*.clood-x.com:8088 {
	redir https://{host}{uri} 301
}

# ---------- staging.clood-x.com ----------
staging.clood-x.com:8443 {
	tls /etc/frankenphp/certs/clood-x-origin.crt /etc/frankenphp/certs/clood-x-origin.key
	root * /var/www/hms-frontend-staging
	request_body {
		max_size 20MB
	}
	encode zstd gzip

	@stTenantSub {
		not path /app/* /api/* /assets/* /worker/* /uploads/* /sanctum/* /share/*
		path_regexp stsub ^/([a-z0-9][-a-z0-9]*)/(.+)$
	}
	rewrite @stTenantSub /{re.stsub.2}
	@stTenantRoot {
		not path /app/* /api/* /assets/* /worker/* /uploads/* /sanctum/* /share/*
		path_regexp stroot ^/[a-z0-9][-a-z0-9]*/?$
	}
	rewrite @stTenantRoot /index.php

	route {
		@stdot path /.ht* /.env* */.ht* */.env*
		respond @stdot 403
	}
	redir /worker/ /worker/index.php 302

	@stAsset {
		path_regexp stasc \.(js|css|woff2?|ttf|eot|otf|svg|ico|png|jpe?g|gif|webp|avif)$
		not path /app/* /uploads/* /worker/sw.js
	}
	route @stAsset {
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle /app/* {
		reverse_proxy 127.0.0.1:8082 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}
	handle_path /uploads/* {
		root * /var/www/hms-backend-staging/storage/app/public/uploads
		header Cache-Control "public, max-age=604800"
		file_server
	}
	@stOctane path /api /api/* /sanctum /sanctum/* /share/*
	handle @stOctane {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
	@stApi path /api /api/*
	header @stApi Cache-Control "no-store"
	@stSw path /worker/sw.js
	header @stSw Cache-Control "no-cache, no-store, must-revalidate"
	@stPhp {
		path *.php
		file {path}
	}
	php @stPhp
	file_server {
		index landing.html
	}
}

# ---------- main: clood-x.com + www + *.clood-x.com ----------
clood-x.com:8443, www.clood-x.com:8443, *.clood-x.com:8443 {
	tls /etc/frankenphp/certs/clood-x.com.crt /etc/frankenphp/certs/clood-x.com.key
	root * /var/www/hms-frontend
	request_body {
		max_size 20MB
	}
	encode zstd gzip

	# tenant-slug rewrites (exclusions mirror nginx lookahead list)
	@tenantSub {
		not path /app/* /api/* /assets/* /worker/* /uploads/* /phpmyadmin/* /sanctum/* /share/* /desktop/* /admin /admin/* /livewire /livewire/* /css/* /js/* /fonts/*
		path_regexp tsub ^/([a-z0-9][-a-z0-9]*)/(.+)$
	}
	rewrite @tenantSub /{re.tsub.2}
	@tenantRoot {
		not path /app/* /api/* /assets/* /worker/* /uploads/* /phpmyadmin/* /sanctum/* /share/* /desktop/* /admin /admin/* /livewire /livewire/* /css/* /js/* /fonts/*
		path_regexp troot ^/[a-z0-9][-a-z0-9]*/?$
	}
	rewrite @tenantRoot /index.php

	# global dotfile deny (stricter than nginx: also inside ^~ prefixes)
	route {
		@dotfiles path /.ht* /.env* */.ht* */.env*
		respond @dotfiles 403
	}

	# /worker/sw.js — never cached
	@swExact path /worker/sw.js
	route @swExact {
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	redir /worker/ /worker/index.php 302

	# asset regex (nginx ~* location) — excluded from ^~ prefixes + uploads + sw.js
	@statAsset {
		path_regexp asc \.(js|css|woff2?|ttf|eot|otf|svg|ico|png|jpe?g|gif|webp|avif)$
		not path /app/* /uploads/* /desktop/* /admin /admin/* /livewire /livewire/* /css/* /js/* /fonts/* /phpmyadmin/* /worker/sw.js
	}
	route @statAsset {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# /desktop/ — installer binaries, octet-stream + no-store
	handle_path /desktop/* {
		root * /var/www/hms-frontend/desktop
		@dotg path /.ht* /.env* */.ht* */.env*
		respond @dotg 403
		header Cache-Control "no-store, no-cache, must-revalidate"
		header Content-Type application/octet-stream
		file_server
	}

	# Reverb WebSocket (prod) /app/* -> :8080
	handle /app/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	# uploads -> backend storage (uniform; also fixes nginx subcontractor-*.png 404)
	handle_path /uploads/* {
		root * /var/www/hms-backend/storage/app/public/uploads
		@dotg path /.ht* /.env* */.ht* */.env*
		respond @dotg 403
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# phpMyAdmin — bcrypt auth (old apr1-MD5 .htpasswd not reusable)
	@pma path /phpmyadmin /phpmyadmin/*
	handle @pma {
		@dotg path /.ht* /.env* */.ht* */.env*
		respond @dotg 403
		basic_auth {
			admin $2y$05$rdTkRdD8pDv5taGuombMpe6f7DMRQn.hdbVUr2uiG6vvezdjK6PCK
		}
		uri strip_prefix /phpmyadmin
		root * /usr/share/phpmyadmin
		try_files {path} {path}/index.php index.php
		@pmaPhp path *.php
		php @pmaPhp
		file_server
		header Cache-Control "no-store, no-cache, must-revalidate, private"
	}

	# Octane proxies — /api /sanctum /share /admin /livewire /css /js /fonts
	@octanePlain {
		path /api /api/* /sanctum /sanctum/* /share/*
		not path */.ht* */.env* /.ht* /.env*
	}
	@octaneCaret path /admin /admin/* /livewire /livewire/* /css/* /js/* /fonts/*
	@octaneAll path /api /api/* /sanctum /sanctum/* /share/* /admin /admin/* /livewire /livewire/* /css/* /js/* /fonts/*
	# plain-prefix paths: nginx regex wins -> dotfiles 403 via catch-all
	handle @octanePlain {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
	# ^~ paths (admin/livewire/css/js/fonts): beat regex -> dotfiles proxied like nginx
	handle @octaneCaret {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}
	@apiNoStore path /api /api/* /sanctum /sanctum/*
	header @apiNoStore Cache-Control "no-store, no-cache, must-revalidate, private"
	header @apiNoStore CDN-Cache-Control "no-store"

	# PHP + static catch-all — same no-cache as nginx .php + location /
	handle {
		@dotg path /.ht* /.env* */.ht* */.env*
		respond @dotg 403
		header Cache-Control "no-cache, no-store, must-revalidate, private"
		@phpMain {
			path *.php
			file {path}
		}
		php @phpMain
		file_server {
			index landing.html
		}
	}
}

# ---------- :80 catch-all (first-block-wins parity) ----------
:8088 {
	redir https://clood-x.com{uri} 301
}
