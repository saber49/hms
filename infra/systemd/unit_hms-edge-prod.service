# /etc/systemd/system/hms-edge-prod.service
[Unit]
Description=HMS FrankenPHP edge — production (:80/:443, nginx replacement)
After=network-online.target hms-octane.service hms-reverb.service mysql.service
Wants=network-online.target

[Service]
User=www-data
Group=www-data
ExecStart=/var/www/hms-backend/frankenphp run --config /etc/frankenphp/Caddyfile.prod
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=XDG_CONFIG_HOME=/var/www/hms-backend/storage/frankenphp/config
Environment=XDG_DATA_HOME=/var/www/hms-backend/storage/frankenphp/data
Environment=HOME=/var/www/hms-backend/storage/frankenphp

[Install]
WantedBy=multi-user.target
